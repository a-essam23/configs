{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-rules@latest"
    ],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "plane": {
            "type": "remote",
            "url": "https://mcp.plane.so/http/mcp"
        },
        "codebase-memory-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "/Users/ae/.local/bin/codebase-memory-mcp"
            ]
        }
    }
}
